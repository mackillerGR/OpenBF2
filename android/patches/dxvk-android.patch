diff --git a/src/wsi/sdl3/wsi_window_sdl3.cpp b/src/wsi/sdl3/wsi_window_sdl3.cpp
index f7dd35a..66fdbf3 100644
--- a/src/wsi/sdl3/wsi_window_sdl3.cpp
+++ b/src/wsi/sdl3/wsi_window_sdl3.cpp
@@ -180,6 +180,33 @@ namespace dxvk::wsi {
           VkSurfaceKHR*             pSurface) {
     SDL_Window* window = fromHwnd(hWindow);
 
+#ifdef __ANDROID__
+    // SDL's Vulkan library may be a different loader from the one holding this instance.
+    // The Vulkan platform header for Android is not enabled in this tree.
+    struct AndroidSurfaceInfo {
+      VkStructureType sType;
+      const void*     pNext;
+      VkFlags         flags;
+      void*           window;
+    };
+
+    using PfnCreate = VkResult (VKAPI_PTR*)(VkInstance, const AndroidSurfaceInfo*,
+      const VkAllocationCallbacks*, VkSurfaceKHR*);
+
+    auto pfnCreate = reinterpret_cast<PfnCreate>(
+      pfnVkGetInstanceProcAddr(instance, "vkCreateAndroidSurfaceKHR"));
+
+    if (!pfnCreate)
+      return VK_ERROR_EXTENSION_NOT_PRESENT;
+
+    AndroidSurfaceInfo info = { };
+    info.sType = VkStructureType(1000008000);
+    info.window = SDL_GetPointerProperty(SDL_GetWindowProperties(window),
+      SDL_PROP_WINDOW_ANDROID_WINDOW_POINTER, nullptr);
+
+    return pfnCreate(instance, &info, nullptr, pSurface);
+#endif
+
     return SDL_Vulkan_CreateSurface(window, instance, nullptr, pSurface)
       ? VK_SUCCESS : VK_ERROR_OUT_OF_HOST_MEMORY;
   }
