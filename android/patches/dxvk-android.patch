@@ -10,6 +11,19 @@
 namespace dxvk::vk {
 
   static std::pair<HMODULE, PFN_vkGetInstanceProcAddr> loadVulkanLibrary() {
+#ifdef __ANDROID__
+    // The app may have opened a loader bound to a bundled driver.
+    if (const char* handle = std::getenv("BF2_VULKAN_LIBRARY")) {
+      auto library = reinterpret_cast<HMODULE>(std::strtoull(handle, nullptr, 16));
+      auto proc = dlsym(library, "vkGetInstanceProcAddr");
+
+      if (proc) {
+        Logger::info("Vulkan: Using the application's loader");
+        return std::make_pair(HMODULE(nullptr), reinterpret_cast<PFN_vkGetInstanceProcAddr>(proc));
+      }
+    }
+#endif
+
     static const std::array dllNames = {
