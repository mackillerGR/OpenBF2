@@ -109,6 +109,13 @@ namespace dxvk {
         sync.acquire, VK_NULL_HANDLE, &m_imageIndex);
     }
 
+#ifdef __ANDROID__
+    // Android reports suboptimal for any rotated display, on every frame. The compositor
+    // handles the rotation, so a new swapchain would change nothing.
+    if (m_acquireStatus == VK_SUBOPTIMAL_KHR)
+      m_acquireStatus = VK_SUCCESS;
+#endif
+
     // This is a normal occurence, but may be useful for
